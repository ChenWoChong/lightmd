{
  "name": "lightmd",
  "private": true,
  "version": "0.1.0",
  "description": "A local Markdown editor with live preview.",
  "author": "lightmd",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "app:dev": "concurrently -k -s first \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && LIGHTMD_DEV_SERVER_URL=http://127.0.0.1:5173 env -u ELECTRON_RUN_AS_NODE electron .\"",
    "app:start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "app:build": "npm run build && electron-builder --mac dir",
    "app:dist": "npm run build && electron-builder --mac",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@uiw/react-codemirror": "^4.25.12",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "pele": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.lightmd.app",
    "productName": "lightmd",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mdx",
          "txt"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "protocols": [
      {
        "name": "lightmd",
        "schemes": [
          "lightmd"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
